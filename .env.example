# Frontend environment (public — safe to commit).
# Only NEXT_PUBLIC_* variables are compiled into the browser bundle.
# Never put DATABASE_URL, passwords, JWT secrets or CA certs in this project.

# Base URL of the Express API, including the API prefix.
# Development: http://localhost:5100/api
# Production:  https://YOUR-BACKEND.onrender.com/api
NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.onrender.com/api

# Socket.IO origin (the backend URL without the /api suffix).
# Leave unset to derive it from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SOCKET_URL=https://YOUR-BACKEND.onrender.com

# Optional branding overrides. Each falls back to a built-in default when unset.
NEXT_PUBLIC_HOSPITAL_NAME=St. Aurelia Teaching Hospital
NEXT_PUBLIC_HOSPITAL_PHONE=+234 700 000 0000
NEXT_PUBLIC_HOSPITAL_EMERGENCY_PHONE=+234 700 000 0001
NEXT_PUBLIC_HOSPITAL_EMAIL=care@st-aurelia.test
NEXT_PUBLIC_HOSPITAL_ADDRESS=14 Harbour Road, Victoria Island, Lagos
