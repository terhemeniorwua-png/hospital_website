{
  "name": "hospital-management-backend",
  "version": "1.0.0",
  "description": "Express.js + PostgreSQL backend for the Hospital Management & Patient Care Platform (REST API + Socket.IO)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --forceExit --coverage",
    "test:smoke": "node scripts/smokeApi.js",
    "check:validators": "node scripts/checkValidators.js",
    "check:validator-models": "node scripts/checkValidatorModels.js",
    "check:routes": "node scripts/checkRoutes.js",
    "check": "npm run check:validators && npm run check:validator-models && npm run check:routes && npm test",
    "migrate": "node scripts/migrate.js up",
    "migrate:undo": "node scripts/migrate.js down",
    "migrate:undo:all": "node scripts/migrate.js down-all",
    "migrate:status": "node scripts/migrate.js status",
    "seed": "node scripts/seed.js up",
    "seed:undo": "node scripts/seed.js down",
    "seed:status": "node scripts/seed.js status",
    "model:generate": "node scripts/generateModel.js",
    "generate:migrations": "node scripts/generateMigrations.js",
    "seed:undo:all": "node scripts/seed.js down-all"
  },
  "keywords": [
    "hospital",
    "express",
    "sequelize",
    "postgresql",
    "socket.io"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4",
    "umzug": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^30.5.2",
    "sequelize-cli": "^6.6.5",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "overrides": {
  "sequelize": {
    "uuid": "^9.0.1"
  }
}
}
