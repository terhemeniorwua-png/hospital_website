# ---------------------------------------------------------------------------
# Copy to `.env` and fill in the blanks. Every value below is read by
# `src/config/env.js`; unknown keys are ignored.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- HTTP server ------------------------------------------------------------
PORT=5100
HOST=0.0.0.0
# All API routes are mounted under this prefix (no trailing slash).
API_PREFIX=/api

# --- Frontend origins --------------------------------------------------------
CLIENT_URL=http://localhost:3000
# Comma-separated allow-list for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database ----------------------------------------------------------------
# DB_PROVIDER=local  -> DATABASE_URL
# DB_PROVIDER=cloud  -> CLOUD_DATABASE_URL (falls back to DATABASE_URL)
DB_PROVIDER=local

# Render: paste the full URI from Aiven (never commit it; `.env` is ignored).
# Keep any `?sslmode=...` suffix out - SSL is controlled by the DB_* flags below.
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>

# --- Connection options (apply to both the app and sequelize-cli) ------------
# Aiven-style hosted Postgres: TLS is required, so enable it explicitly.
DB_SSL=true
# Set to false until DB_CA_CERT is in place (see below), then true.
DB_SSL_REJECT_UNAUTHORIZED=false
# Optional: paste the contents of Aiven's ca.pem here (single line, PEM escaped
# or one long value). When set, the certificate chain is verified strictly and
# DB_SSL_REJECT_UNAUTHORIZED is ignored.
# DB_CA_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=60000
DB_CONNECTION_TIMEOUT_MS=30000

# Local fallback (used only when DATABASE_URL / CLOUD_DATABASE_URL are unset).
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=hospital_db
# DB_USER=hospital
# DB_PASSWORD=hospital

# Render: NODE_ENV=production
# On Render also set JWT_SECRET / JWT_REFRESH_SECRET as secrets, not in this file.

# --- Authentication ----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=hospital-management-api
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_EXPIRES_IN=1h

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# --- Domain defaults ---------------------------------------------------------
CURRENCY=NGN
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
HOSPITAL_NUMBER_PREFIX=HOSP
HOSPITAL_NUMBER_YEAR=2026
EXPIRY_WARNING_DAYS=90

# --- Background jobs ---------------------------------------------------------
# Set to false to disable the interval jobs (stock, expiry, escalation, etc).
JOB_INTERVALS_ENABLED=true
